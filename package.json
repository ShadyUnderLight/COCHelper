{
  "name": "coc-helper",
  "private": true,
  "version": "0.0.0",
  "description": "Clash of Clans 本地数据与升级追踪桌面应用（纯 Electron + TypeScript）",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "^24.18.0",
    "pnpm": ">=11.16.0"
  },
  "scripts": {
    "start": "pnpm --filter @coc-helper/desktop start",
    "package": "pnpm --filter @coc-helper/desktop package",
    "make": "pnpm --filter @coc-helper/desktop make",
    "release:prepare": "node scripts/release-prepare.mjs",
    "test": "vitest run",
    "test:parity": "vitest run --config vitest.parity.config.ts",
    "test:fault-replay": "vitest run packages/testkit/src/fault.replay.test.ts packages/domain/src/persistence/atomic-write.test.ts packages/domain/src/persistence/transactions.test.ts",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:renderer-isolation": "node scripts/check-renderer-node-isolation.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:account-fixtures": "node scripts/check-account-fixture-sync.mjs",
    "check:golden-fixtures": "node scripts/check-golden-fixture-sync.mjs",
    "smoke": "node scripts/electron-smoke.mjs",
    "test:e2e:packaged": "node scripts/electron-e2e.mjs",
    "perf:release": "node scripts/electron-perf.mjs",
    "perf:gate": "node scripts/perf-gate.mjs",
    "check:oracle-isolation": "node scripts/check-oracle-isolation.mjs",
    "baseline:e1-02": "node scripts/e1-02-baseline.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.6.2",
    "semver": "^7.8.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
