{
  "name": "coc-helper",
  "private": true,
  "version": "0.0.0",
  "description": "COC 助手 Electron 宿主（迁移期与 Swift 并存）",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "^24.18.0",
    "pnpm": ">=11.16.0"
  },
  "scripts": {
    "start": "pnpm --filter @coc-helper/desktop start",
    "package": "pnpm --filter @coc-helper/desktop package",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:parity": "vitest run --project parity",
    "test:replay": "vitest run --project replay",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:renderer-isolation": "node scripts/check-renderer-node-isolation.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:testkit-isolation": "node scripts/check-testkit-isolation.mjs",
    "smoke": "node scripts/electron-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
